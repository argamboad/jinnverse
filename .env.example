# Copy this file to `.env` and fill it in. `.env` is gitignored: never commit it.
# Every variable is read by src/jinnverse/settings.py. Real environment variables win over this file.

# Postgres. This default matches docker-compose.yml (`docker compose up -d`).
JINNVERSE_DATABASE_URL=postgresql+asyncpg://jinnverse:jinnverse@localhost:5440/jinnverse

# The one user who can sign in.
JINNVERSE_USERNAME=
JINNVERSE_PASSWORD=

# Signs the bearer tokens; at least 32 characters. Changing it signs every device out.
# Generate one with:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JINNVERSE_TOKEN_SECRET=

# Optional. Days a sign-in lasts (default 30).
# JINNVERSE_TOKEN_DAYS=30

# Optional. Browser origins allowed to call the API, as a JSON list (default: none).
# JINNVERSE_CORS_ORIGINS=["http://localhost:5173"]

# Optional. Serve /docs, /redoc and /openapi.json (default: false). Turn it on for development;
# a deployed API leaves it off.
JINNVERSE_DOCS=true

# Optional. Sign-in throttling: failed attempts allowed within the window (default 5), the window
# in minutes, which is also how long a lockout lasts (default 15), and how long each wrong password
# waits before it is answered (default 1 second).
# JINNVERSE_SIGN_IN_ATTEMPTS=5
# JINNVERSE_SIGN_IN_WINDOW_MINUTES=15
# JINNVERSE_SIGN_IN_FAILURE_DELAY_SECONDS=1

# The model, through OpenRouter. The key is from https://openrouter.ai/keys; without it the app
# starts but every turn fails before anything is sent.
JINNVERSE_OPENROUTER_API_KEY=

# Optional. The defaults: DeepSeek V4 Flash, temperature 1.0, 1024 tokens per reply, 180 s to
# connect and between chunks, reasoning switched off on replies.
# JINNVERSE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# JINNVERSE_MODEL=deepseek/deepseek-v4-flash
#
# The model writes every story's replies: one for all, on purpose (a model per story was built
# in step 7 and taken out, #140). Trying another is a change of this line, for every story at
# once, judged on real stories — never a router that swaps models on a word in the message.
# Criterion one is that it does not refuse; prose second; cost a distant third. Candidates, as
# OpenRouter names them on 2026-11-05 (prices per million tokens, prompt / completion; check
# https://openrouter.ai/models before relying on either). The Render variables to set for
# each one are in docs/DEPLOYMENT.md, "Trying another model":
#   deepseek/deepseek-v4-flash      the default. 1M context, $0.09 / $0.18. Holds at temperature
#                                   1.3; does not refuse. Send reasoning off (the default here).
#   deepseek/deepseek-v4.1-flash    the same family, newer. 1M context, $0.04 / $0.50: cheaper on
#                                   the prompt, dearer on the reply. Not yet tried on a story.
#   sao10k/l3.1-euryale-70b         a Llama 3.1 roleplay finetune, 131k context, $0.85 / $0.85.
#                                   Built to not refuse. In airp's tests the Llama finetunes wrote
#                                   cleanly up to temperature 0.9 and turned to token soup above
#                                   it: lower JINNVERSE_TEMPERATURE with it.
#   thedrummer/cydonia-24b-v4.1     a Mistral Small finetune, 131k context, $0.30 / $0.50. Same
#                                   family of finetune, smaller and cheaper; the same note on
#                                   temperature.
#   google/gemini-2.5-pro           1M context, $1.25 / $10. Strong at long, plotted worlds, and
#                                   aligned: it refuses what this app is for. Listed so the
#                                   reason it is not used is written down. google/gemini-4-argon
#                                   ($2 / $10) and the Claude Sonnets ($2-3 / $10-15) refuse the
#                                   same way, and a "jailbreak" prompt to get past that is out
#                                   (why: DEPLOYMENT.md, "Trying another model").
# Names from the review document and its thread that do not exist on OpenRouter (2026-11-05):
# `sao10k/l3-70b-euryale-v2.1` is the Euryale above and `thedrummer/cydonia-24b` the Cydonia;
# Stheno is gone; "Magnum Cydonia" is two models (Cydonia, and anthracite-org/magnum-v4-72b,
# 32k context); Claude 3.5 and 4.1 Sonnet are not offered (the current ones run 4.5 to 5.5).
# JINNVERSE_TEMPERATURE=1.0
# JINNVERSE_MAX_TOKENS=1024
# JINNVERSE_MODEL_TIMEOUT_SECONDS=180
# JINNVERSE_THINK_BEFORE_REPLYING=false
# Optional. The model for summaries and fact extraction (default: the same as JINNVERSE_MODEL).
# JINNVERSE_BACKGROUND_MODEL=
# Optional. Retrieval: the embedding model (empty switches it off), how many turns may be
# recalled (default 4), and the least similarity (default 0.35).
# JINNVERSE_EMBEDDING_MODEL=openai/text-embedding-3-small
# JINNVERSE_RECALL_COUNT=4
# JINNVERSE_RECALL_THRESHOLD=0.35

# Optional. The prompt budget in tokens (default 32000), the share of it recalled memories may
# take (default 10%), and the share a character's lore entries may take (default 20%).
# JINNVERSE_CONTEXT_BUDGET=32000
# JINNVERSE_RECALL_PERCENT=10
# JINNVERSE_LORE_PERCENT=20

# Optional. OpenRouter hosts to prefer or avoid, by slug (lower-case, e.g. "deepinfra"), as
# JSON lists; and whether other hosts may serve when the preferred ones cannot.
# JINNVERSE_PREFER_PROVIDERS=["deepinfra"]
# JINNVERSE_IGNORE_PROVIDERS=["chutes"]
# JINNVERSE_ALLOW_PROVIDER_FALLBACKS=true
